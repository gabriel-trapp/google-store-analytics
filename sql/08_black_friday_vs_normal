WITH periods AS (SELECT CASE WHEN event_date BETWEEN '20201101' AND '20201120' THEN 'normal'
            WHEN event_date BETWEEN '20201127' AND '20201130' THEN 'bf_cm' END AS period,
       COUNT(DISTINCT event_date) AS nb_days,
       COUNT(DISTINCT CASE WHEN event_name = 'view_item'        THEN user_pseudo_id END) AS viewers,
       COUNT(DISTINCT CASE WHEN event_name = 'purchase'         THEN user_pseudo_id END) AS purchasers
FROM `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
GROUP BY 1)
  
SELECT *, ROUND(SAFE_DIVIDE(purchasers, viewers)*100, 2) AS conversion_rate
FROM periods
WHERE period IS NOT NULL
ORDER BY CASE period WHEN 'normal' THEN 1 WHEN 'bf_cm' THEN 2 END;
